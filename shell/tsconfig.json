{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": [
      "@types/node",
      "@nuxt/types",
    ]
  },
  "include": [
    "**/*.vue",
    "**/*.ts",
    "**/*.js"
  ],
  "exclude": [
    "./creators",
    "./scripts",
    "./script/standalone",
    "**/__mocks__/*",
    "**/__tests__/*",
    "**/*.spec.ts",
    "**/*.test.ts"
  ]
}