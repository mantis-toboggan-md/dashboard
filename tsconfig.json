{
  "compilerOptions": {
    "target": "ES2018",
    "module": "ESNext",
    "moduleResolution": "Node",
    "lib": [
      "ESNext",
      "ESNext.AsyncIterable",
      "DOM"
    ],
    "esModuleInterop": true,
    "allowJs": true,
    "sourceMap": true,
    "strict": true,
    "noEmit": false,
    "baseUrl": ".",
    "rootDir": ".",
    "paths": {
      "~/*": [
        "./*"
      ],
      "@/*": [
        "./*"
      ],
      "@shell/*": [
        "./shell/*"
      ],
      "@pkg/*": [
        "./shell/pkg/*"
      ],
      "@components/*": [
        "./pkg/rancher-components/src/components/*"
      ]
    },
    "typeRoots": [
      "./node_modules/@types"
    ]
  },
  "include": [],
  "exclude": [
    "node_modules",
    "shell/node_modules",
    "pkg/**/node_modules",
    "dist",
    "dist-pkg",
  ]
}